# Mainnet settings: copy to Vercel (Production) or to .env.local. Public values only here;
# put the secrets (marked) into Vercel as Sensitive variables, never into git.
# Release steps and checks: docs/DEPLOY.md, "Mainnet release".
NEXT_PUBLIC_NETWORK=mainnet
# The mainnet escrow account from deploy-escrow.mjs. Required: the build stops without it.
NEXT_PUBLIC_EVENTS_CONTRACT=
# Defaults on mainnet, shown for reference:
# NEXT_PUBLIC_USDC_CONTRACT=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
# NEXT_PUBLIC_INTENTS_CONTRACT=intents.near
# NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.fastnear.com
# NEAR Auth (Google/email): our own Auth0 client id from the NEAR Auth access application.
# Without it the Google button is hidden.
NEXT_PUBLIC_FASTAUTH_CLIENT_ID=
# Public https address of the site, used in widget code and links.
PUBLIC_URL=https://www.nearvent.site

# Server-only. The relayer pays gas for EVM and Google/email users, payouts to Intents,
# NEAR Auth signing and new Google accounts (0.003 NEAR each). Keep at least 5 NEAR on it;
# the escrow must be initialised with the same relayer account.
RELAYER_ACCOUNT_ID=
# RELAYER_PRIVATE_KEY=            (secret)
# Signs staff-session tokens: a new long random string, not the testnet one.
# APP_SECRET=                     (secret)
# A separate Upstash Redis database for mainnet (event details, check-ins, names, profiles, covers).
# UPSTASH_REDIS_REST_URL=         (secret)
# UPSTASH_REDIS_REST_TOKEN=       (secret)
# Required on mainnet: relayer and 1Click routes refuse requests without a shared quota.
# RATE_LIMIT_REDIS_URL=           (secret; can be the same mainnet Upstash database)
# RATE_LIMIT_REDIS_TOKEN=         (secret)
# 1Click JWT from partners.near-intents.org: 0.01% instead of +0.25% on USDC quotes.
# ONECLICK_API_KEY=               (secret)
