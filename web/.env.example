# Copy to .env.local. Public values only, except ONECLICK_API_KEY (server-only, optional).
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_EVENTS_CONTRACT=escrow-tp3.nearevents-11022103.testnet
NEXT_PUBLIC_USDC_CONTRACT=usdc.tidepool-sandbox.testnet
# NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# NEAR Intents verifier. Defaults: intents.near on mainnet, Tidepool's verifier on testnet.
# NEXT_PUBLIC_INTENTS_CONTRACT=verifier.tidepool-sandbox.testnet
# ONECLICK_API_KEY=
# Shared Redis REST quota for hosted and mainnet relayer and 1Click endpoints.
# RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_REDIS_TOKEN=
# Relayer (server-only): pays gas for FastAuth (Google/email) signing and Intents
# payouts; on testnet it also funds new accounts with a little NEAR and mints test USDC.
# RELAYER_ACCOUNT_ID=
# RELAYER_PRIVATE_KEY=
# FastAuth (Google/email sign-in). Testnet can use the shared Auth0 client from docs.auth.near.org.
# NEXT_PUBLIC_FASTAUTH_CLIENT_ID=<auth0-client-id>
# Telegram admin bot (server-only). Create one with @BotFather.
# TELEGRAM_BOT_TOKEN=
# Public https address of this app, used in bot links and widget code.
# PUBLIC_URL=https://your-app.example
# Signs staff-session tokens for check-ins and event-detail saves (any long random string; falls back to RELAYER_PRIVATE_KEY).
# APP_SECRET=
# Door check-ins and public event details storage on Vercel (Upstash Redis REST). Locally: web/.data/*.json.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# The bot's @username without @, for the "Start in Telegram" button on the landing page.
# NEXT_PUBLIC_TELEGRAM_BOT=
