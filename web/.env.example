# Copy to .env.local. Public values only, except ONECLICK_API_KEY (server-only, optional).
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_EVENTS_CONTRACT=nearevents-11022103.testnet
NEXT_PUBLIC_USDC_CONTRACT=usdc-nearevents-11022103.testnet
# NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# ONECLICK_API_KEY=
# Testnet relayer for Google/email users (server-only): pays fast-auth signing,
# funds new accounts with a little NEAR and mints test USDC.
# RELAYER_ACCOUNT_ID=
# RELAYER_PRIVATE_KEY=
# NEXT_PUBLIC_FASTAUTH_CLIENT_ID=np8paqIpMWmNbzT4xAvOOapZBjsOpptl  # shared testnet Auth0 client from docs.auth.near.org
# Telegram admin bot (server-only). Create one with @BotFather.
# TELEGRAM_BOT_TOKEN=
# Public https address of this app, used in bot links and Luma webhooks.
# PUBLIC_URL=https://your-app.example
# Encrypts stored Luma API keys (any long random string).
# APP_SECRET=
